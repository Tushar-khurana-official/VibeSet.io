# ===================================================
# WhatsApp Business Chatbot - Environment Variables
# ===================================================

# Server Port
PORT=3000

# Meta WhatsApp Cloud API Configuration
# Get these from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_TOKEN="EAAxxxxxxx"
PHONE_NUMBER_ID="109876543210987"
WHATSAPP_BUSINESS_ACCOUNT_ID="123456789012345"
VERIFY_TOKEN="my_secure_webhook_verify_token_2026"
APP_SECRET="0123456789abcdef0123456789abcdef"

# Broadcast send delay in milliseconds (default: 1000ms = 1 msg/sec)
SEND_DELAY_MS=1000

# Business Owner WhatsApp Phone (E.164 format, e.g., 919876543210)
# Receives instant WhatsApp notifications when new customer orders are placed
OWNER_PHONE="919876543210"

# Admin API Key (used in X-Admin-Api-Key header for admin endpoints)
ADMIN_API_KEY="wh_admin_secret_key_prod_2026"

# Neon PostgreSQL Connection String (Free tier at neon.tech)
# e.g., postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/whatsapp_bot"

# Upstash Redis Connection String (Free tier at upstash.com)
# e.g., rediss://default:password@us1-sample-12345.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# AI Studio injected variables (optional / runtime)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

